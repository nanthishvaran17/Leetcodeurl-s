# Database
DATABASE_URL=sqlite:///./data/leetcode_tracker.db

# Security
SECRET_KEY=super-secret-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Kolkata

# LeetCode Scraper & Request Management
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15
MAX_RETRIES=3
CACHE_DURATION=30

# Weekly Session Config
SESSION_START=08:00
SESSION_END=09:30
SESSION_DAY=6 # 6 = Sunday in 0-indexed Monday-based or 0=Sunday (handled in config)
PROGRESS_THRESHOLD=1

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@college.edu
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@college.edu
REPORT_RECIPIENT_EMAILS=hod.cyber@college.edu,hod.iot@college.edu

# Telegram / WhatsApp Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# College Branding
COLLEGE_NAME=College of Engineering & Technology
COLLEGE_LOGO_URL=/logo.png
