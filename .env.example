# ==============================================================================
# NANDHA LEETCODE INTELLIGENCE (NLCI) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local or production environment variables.
# ==============================================================================

# Database Configuration
# Local Development: defaults to SQLite WAL mode (zero-config startup)
# Production: postgresql://user:password@localhost:5432/nandha_leetcode
DATABASE_URL=sqlite:///./data/leetcode_tracker.db
ENVIRONMENT=development

# Administrator Authentication (REQUIRED)
# IMPORTANT: Always set a strong, non-default password for production environments
ADMIN_EMAIL=admin@nandhaengg.org
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Security & Session Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=your-production-secret-key-change-this-min-32-chars
OTP_HMAC_SECRET=your-production-otp-hmac-secret-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=admin_session_token
SESSION_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Server & Network Configuration
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Kolkata
PRODUCTION_DOMAIN=nandha-leetcode.duckdns.org

# LeetCode Ingestion & Rate-Limiting Engine
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15
MAX_RETRIES=3
CACHE_DURATION=30
SYNC_FRESHNESS_HOURS=6.0
CONCURRENCY_WORKERS=8

# Contest Window Timings (IST)
# Weekly Contest: Sunday 08:00 - 09:30 AM IST (SESSION_DAY=6)
# Biweekly Contest: Alternate Saturdays 20:00 - 21:30 PM IST (SESSION_DAY=5)
SESSION_START=08:00
SESSION_END=09:30
SESSION_DAY=6
PROGRESS_THRESHOLD=1

# Firebase Integration (Cloud Firestore & Realtime Database)
FIREBASE_DATABASE_URL=https://leetcode-student-data-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=leetcode-student-data
FIREBASE_SERVICE_ACCOUNT_KEY=

# Email & Notification Dispatch (SMTP / Brevo API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@nandhaengg.org
REPORT_RECIPIENT_EMAILS=placement@nandhaengg.org,hod.cse@nandhaengg.org

# Institutional Branding
COLLEGE_NAME=NANDHA ENGINEERING COLLEGE (AUTONOMOUS)
COLLEGE_ADDRESS=ERODE - 638 052, TAMIL NADU
COLLEGE_LOGO_URL=/nec_25_logo.png
