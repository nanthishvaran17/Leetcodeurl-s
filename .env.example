# Database
DATABASE_URL=sqlite:///./data/leetcode_tracker.db

# Admin Authentication
ADMIN_EMAIL=your-authorized-admin-email@nandhaengg.org
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Security & Session Secrets
SECRET_KEY=your-production-secret-key-change-this
OTP_HMAC_SECRET=your-production-otp-hmac-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_COOKIE_NAME=admin_session_token
SESSION_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173

# Server
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Kolkata

# LeetCode Scraper & Request Management
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=15
MAX_RETRIES=3
CACHE_DURATION=30

# Weekly Session Config
SESSION_START=08:00
SESSION_END=09:30
SESSION_DAY=6
PROGRESS_THRESHOLD=1

# Email Configuration (SMTP / API)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
REPORT_RECIPIENT_EMAILS=hod.cyber@nandhaengg.org,hod.iot@nandhaengg.org
RESEND_API_KEY=
BREVO_API_KEY=

# College Branding
COLLEGE_NAME=NANDHA ENGINEERING COLLEGE (AUTONOMOUS)
COLLEGE_LOGO_URL=/logo.png

