rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffOrAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'staff' || 
        getUserData().role == 'admin' ||
        getUserData().role == 'Super Admin'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' || 
        getUserData().role == 'Super Admin'
      );
    }

    // Users Collection: users/{uid}
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && request.resource.data.role == 'student';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Public Read Access for College Student Solvers & Leaderboard Analytics
    match /students/{studentId} {
      allow read: if true;
      allow write: if isStaffOrAdmin() || request.auth != null;
    }

    match /leetcodeStats/{studentId} {
      allow read: if true;
      allow write: if isStaffOrAdmin() || request.auth != null;
    }

    match /leaderboard/{studentId} {
      allow read: if true;
      allow write: if isStaffOrAdmin() || request.auth != null;
    }

    match /dailyStats/{id} {
      allow read: if true;
      allow write: if isStaffOrAdmin() || request.auth != null;
    }

    match /public_leaderboard/{id} {
      allow read: if true;
      allow write: if isStaffOrAdmin() || request.auth != null;
    }

    match /activityLogs/{id} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }
  }
}
