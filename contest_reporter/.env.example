# ─── LeetCode credentials ──────────────────────────────────────────────────
LEETCODE_USERNAME=nanthishvaran_07

# ─── Gmail SMTP (use an App Password, NOT your Gmail login password) ────────
# Create App Password: https://myaccount.google.com/apppasswords
# Enable 2FA first, then generate an App Password for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx       # 16-char App Password (no spaces needed)

# ─── Display name shown in the From field ───────────────────────────────────
SENDER_NAME=NEC LeetCode Tracker

# ─── Rating-settled check behaviour ─────────────────────────────────────────
# How many times to retry if rating hasn't settled yet (after the initial check)
RATING_SETTLED_RETRIES=1
# How many minutes to wait between retries
RATING_SETTLED_WAIT_MINUTES=20
